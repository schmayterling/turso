@database :memory:

setup distinct_ordered {
    CREATE TABLE t(a,b);
    CREATE INDEX idx ON t(a ASC,b DESC);
    INSERT INTO t VALUES (NULL,NULL),(NULL,NULL),(NULL,'z'),(NULL,'z'),
        (1,'a'),(1,'a'),(1,'b'),(2,'a'),(2,'a'),(3,NULL);
}

@setup distinct_ordered
test distinct-ordered-null {
    SELECT quote(a) FROM (SELECT DISTINCT a FROM t INDEXED BY idx);
}
expect {
    NULL
    1
    2
    3
}

test distinct-ordered-storage-classes {
    CREATE TABLE t(a);
    CREATE INDEX idx ON t(a);
    INSERT INTO t VALUES (NULL),(NULL),(1),(1.0),('1'),('1'),(X'31'),(X'31');
    SELECT typeof(a),quote(a) FROM (SELECT DISTINCT a FROM t INDEXED BY idx);
}
expect {
    null|NULL
    integer|1
    text|'1'
    blob|X'31'
}

@setup distinct_ordered
test distinct-ordered-composite {
    SELECT quote(a),quote(b) FROM (
        SELECT DISTINCT a,b FROM t INDEXED BY idx ORDER BY a ASC,b DESC
    );
}
expect {
    NULL|'z'
    NULL|NULL
    1|'b'
    1|'a'
    2|'a'
    3|NULL
}

@setup distinct_ordered
test distinct-ordered-reverse {
    SELECT quote(a),quote(b) FROM (
        SELECT DISTINCT a,b FROM t INDEXED BY idx ORDER BY a DESC,b ASC
    );
}
expect {
    3|NULL
    2|'a'
    1|'a'
    1|'b'
    NULL|NULL
    NULL|'z'
}

@setup distinct_ordered
test distinct-ordered-range {
    SELECT DISTINCT a,b FROM t INDEXED BY idx WHERE a >= 1 AND a < 3;
}
expect {
    1|b
    1|a
    2|a
}

@setup distinct_ordered
test distinct-ordered-all-null {
    SELECT quote(a),quote(b) FROM (
        SELECT DISTINCT a,b FROM t INDEXED BY idx WHERE b IS NULL
    );
}
expect {
    NULL|NULL
    3|NULL
}

@setup distinct_ordered
test distinct-ordered-limit-offset {
    SELECT quote(a),quote(b) FROM (
        SELECT DISTINCT a,b FROM t INDEXED BY idx LIMIT 2 OFFSET 1
    );
}
expect {
    NULL|NULL
    1|'b'
}

test distinct-ordered-collation {
    CREATE TABLE t(a TEXT COLLATE NOCASE);
    CREATE INDEX idx ON t(a);
    INSERT INTO t VALUES ('a'),('A'),('b'),('B'),('a');
    SELECT DISTINCT a FROM t INDEXED BY idx;
    SELECT DISTINCT a COLLATE NOCASE FROM t INDEXED BY idx;
    SELECT DISTINCT a COLLATE BINARY FROM t INDEXED BY idx ORDER BY 1;
}
expect {
    a
    b
    a
    b
    A
    B
    a
    b
}

@setup distinct_ordered
test distinct-ordered-sorter {
    SELECT quote(a),quote(b) FROM (
        SELECT DISTINCT a,b FROM t INDEXED BY idx ORDER BY b ASC,a DESC
    );
}
expect {
    3|NULL
    NULL|NULL
    2|'a'
    1|'a'
    1|'b'
    NULL|'z'
}

@setup distinct_ordered
test distinct-ordered-correlated {
    CREATE TABLE driver(n,x);
    INSERT INTO driver VALUES (1,1),(2,1),(3,2),(4,2),(5,1);
    SELECT n,(SELECT DISTINCT a FROM t INDEXED BY idx WHERE a >= x LIMIT 1)
        FROM driver ORDER BY n;
}
expect {
    1|1
    2|1
    3|2
    4|2
    5|1
}

@setup distinct_ordered
test distinct-ordered-fallback {
    SELECT DISTINCT b FROM t INDEXED BY idx WHERE a=1 ORDER BY b;
    SELECT DISTINCT b FROM t INDEXED BY idx WHERE a IN (1,2) ORDER BY b;
    SELECT quote(b) FROM (SELECT DISTINCT b FROM t INDEXED BY idx ORDER BY b);
    SELECT DISTINCT t.b FROM t JOIN (SELECT 1 AS x UNION ALL SELECT 2) u ON t.a=u.x ORDER BY t.b;
}
expect {
    a
    b
    a
    b
    NULL
    'a'
    'b'
    'z'
    a
    b
}

@backend rust
test distinct-ordered-plan {
    CREATE TABLE t(a,b);
    CREATE INDEX idx ON t(a);
    EXPLAIN QUERY PLAN SELECT DISTINCT a FROM t;
}
expect pattern {
    ^\d+\|\d+\|\d+\|SCAN t USING COVERING INDEX idx$
}

@cross-check-integrity
test distinct-select-null {
    CREATE TABLE distinct_test (x);
    INSERT INTO distinct_test VALUES (1), (1), (NULL), (NULL), (2);
    SELECT CASE WHEN x IS NULL then 'NULL' ELSE x END FROM (SELECT DISTINCT x FROM distinct_test ORDER BY x IS NULL, x);
}
expect {
    1
    2
    NULL
}

@cross-check-integrity
test distinct-count-null {
    CREATE TABLE distinct_test (x);
    INSERT INTO distinct_test VALUES (1), (1), (NULL), (NULL), (2);
    SELECT count(DISTINCT x) FROM distinct_test;
}
expect {
    2
}

@cross-check-integrity
test distinct-multi-column {
    CREATE TABLE distinct_pairs (a, b);
    INSERT INTO distinct_pairs VALUES (1, 1), (1, 1), (1, 2), (2, NULL), (2, NULL);
    SELECT a, CASE WHEN b IS NULL THEN 'NULL' ELSE b END
    FROM (SELECT DISTINCT a, b FROM distinct_pairs)
    ORDER BY a, b IS NULL, b;
}
expect {
    1|1
    1|2
    2|NULL
}

@cross-check-integrity
test distinct-order-by {
    CREATE TABLE distinct_order (a);
    INSERT INTO distinct_order VALUES (3), (2), (2), (1);
    SELECT DISTINCT a FROM distinct_order ORDER BY a DESC;
}
expect {
    3
    2
    1
}

@cross-check-integrity
test distinct-collate-count {
    CREATE TABLE distinct_collate (x TEXT);
    INSERT INTO distinct_collate VALUES ('a'), ('A'), ('b');
    SELECT count(DISTINCT x COLLATE NOCASE) FROM distinct_collate;
}
expect {
    2
}

@cross-check-integrity
test distinct-agg-group-by {
    CREATE TABLE distinct_group (a, b);
    INSERT INTO distinct_group VALUES (1, 10), (1, 10), (1, 20), (2, NULL), (2, NULL);
    SELECT a, count(DISTINCT b) FROM distinct_group GROUP BY a ORDER BY a;
}
expect {
    1|2
    2|0
}

@cross-check-integrity
test distinct-expression {
    CREATE TABLE distinct_expr (x);
    INSERT INTO distinct_expr VALUES (1), (2), (3), (4);
    SELECT DISTINCT (x % 2) FROM distinct_expr ORDER BY 1;
}
expect {
    0
    1
}

@cross-check-integrity
test distinct-text-nocase {
    CREATE TABLE distinct_text (x TEXT);
    INSERT INTO distinct_text VALUES ('a'), ('A'), ('b'), ('B'), ('b');
    SELECT DISTINCT x COLLATE NOCASE FROM distinct_text ORDER BY x COLLATE NOCASE;
}
expect {
    a
    b
}

@cross-check-integrity
test distinct-text-binary {
    CREATE TABLE distinct_text_bin (x TEXT);
    INSERT INTO distinct_text_bin VALUES ('a'), ('A'), ('a');
    SELECT DISTINCT x FROM distinct_text_bin ORDER BY x;
}
expect {
    A
    a
}

@cross-check-integrity
test distinct-order-by-nonselect {
    CREATE TABLE distinct_order_by (a, b);
    INSERT INTO distinct_order_by VALUES (1, 3), (1, 2), (2, 1), (2, 1);
    SELECT DISTINCT a FROM distinct_order_by ORDER BY b DESC, a;
}
expect {
    1
    2
}

@cross-check-integrity
test distinct-limit-offset {
    CREATE TABLE distinct_limit (x);
    INSERT INTO distinct_limit VALUES (1), (1), (2), (3), (3), (4);
    SELECT DISTINCT x FROM distinct_limit ORDER BY x LIMIT 2 OFFSET 1;
}
expect {
    2
    3
}

# Regression: OFFSET must be applied after DISTINCT deduplication.
# This query projects all input rows to the same value (0), so DISTINCT yields
# exactly one row. OFFSET 2 should therefore skip that one row and return empty.
@cross-check-integrity
test distinct-offset-applies-after-dedup {
    CREATE TABLE distinct_offset_order (a INTEGER PRIMARY KEY, b TEXT);
    INSERT INTO distinct_offset_order VALUES (1, 'x'), (2, 'y'), (3, 'z'), (4, 'w');
    SELECT DISTINCT 0 FROM distinct_offset_order ORDER BY a LIMIT 100 OFFSET 2;
}
expect {
}

@cross-check-integrity
test distinct-where {
    CREATE TABLE distinct_where (x);
    INSERT INTO distinct_where VALUES (NULL), (1), (2), (2), (3);
    SELECT DISTINCT x FROM distinct_where WHERE x >= 2 ORDER BY x;
}
expect {
    2
    3
}

@cross-check-integrity
test distinct-agg-with-having {
    CREATE TABLE distinct_having (a, b);
    INSERT INTO distinct_having VALUES (1, 1), (1, 2), (1, 2), (2, 2), (2, 2);
    SELECT a, count(DISTINCT b) FROM distinct_having GROUP BY a HAVING count(DISTINCT b) > 1 ORDER BY a;
}
expect {
    1|2
}

@cross-check-integrity
test distinct-multi-null-keys {
    CREATE TABLE distinct_multi_null (a, b);
    INSERT INTO distinct_multi_null VALUES (1, NULL), (1, NULL), (1, 2), (NULL, 2), (NULL, 2);
    SELECT CASE WHEN a IS NULL THEN 'NULL' ELSE a END,
           CASE WHEN b IS NULL THEN 'NULL' ELSE b END
    FROM (SELECT DISTINCT a, b FROM distinct_multi_null)
    ORDER BY a IS NULL, a, b IS NULL, b;
}
expect {
    1|2
    1|NULL
    NULL|2
}

@cross-check-integrity
test distinct-empty {
    CREATE TABLE distinct_empty (x);
    SELECT DISTINCT x FROM distinct_empty;
}
expect {
}

@cross-check-integrity
test distinct-order-by-expression {
    CREATE TABLE distinct_order_expr (x);
    INSERT INTO distinct_order_expr VALUES (1), (2), (2), (3), (4);
    SELECT DISTINCT x FROM distinct_order_expr ORDER BY (x % 2), x DESC;
}
expect {
    4
    2
    3
    1
}

@cross-check-integrity
test distinct-subquery {
    CREATE TABLE distinct_subq (x);
    INSERT INTO distinct_subq VALUES (1), (1), (2), (3), (3);
    SELECT DISTINCT x FROM (SELECT x FROM distinct_subq) ORDER BY x;
}
expect {
    1
    2
    3
}

@cross-check-integrity
test distinct-agg-simple-count {
    CREATE TABLE distinct_count (x);
    INSERT INTO distinct_count VALUES (1), (1), (2), (2), (3);
    SELECT count(DISTINCT x) FROM distinct_count;
}
expect {
    3
}

# Regression: EXISTS over DISTINCT+OFFSET must return true when rows remain.
@cross-check-integrity
test distinct-exists-with-offset {
    CREATE TABLE distinct_exists (a REAL UNIQUE, b INTEGER);
    INSERT INTO distinct_exists VALUES (1.1, 10), (2.2, 20), (3.3, 30);
    SELECT COUNT(*) FROM (
        SELECT DISTINCT a
        FROM distinct_exists
        ORDER BY a
        LIMIT 99 OFFSET 1
    );
    SELECT EXISTS(
        SELECT DISTINCT a
        FROM distinct_exists
        ORDER BY a
        LIMIT 99 OFFSET 1
    );
}
expect {
    2
    1
}
